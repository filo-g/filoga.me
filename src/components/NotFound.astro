---
import art from "../assets/not-found.txt?raw";
import { PROMPT } from "../lib/terminal";
import Figlet from "./Figlet.astro";
import Session from "./Session.astro";
---

<h1 class="sr-only">404, page not found</h1>

<Session command="cd">
    <p>Invalid directory</p>
    <p>&nbsp;</p>
    <Figlet art={art} label="404 not found" />
    <p>&nbsp;</p>
    <p><a href="/">Back to home</a></p>
</Session>

<script is:inline define:vars={{ PROMPT }}>
    // Static page, the missing path is only known in the browser
    const session = document.querySelector("[data-session]");
    const path = decodeURI(location.pathname).replaceAll("/", "\\");
    session.dataset.command = `cd ${path}`;
    session.querySelector("[data-echo]").textContent = PROMPT + `cd ${path}`;
</script>
