---
import domain from "../assets/filoga-me.txt?raw";
import { PROMPT } from "../lib/terminal";
import Figlet from "./Figlet.astro";

interface Props {
    command?: string;
    prompt?: string;
    // Banner figlet, the domain unless a page sets its own or none
    art?: string | false;
    label?: string;
}

const {
    command,
    prompt = PROMPT,
    art = domain,
    label = "filoga.me",
} = Astro.props;
---

<div data-session data-command={command}>
    {command && <p data-echo aria-hidden="true">{prompt}{command}</p>}
    <!-- Aside first on mobile, beside the banner and centered on desktop -->
    <div class="banner">
        <slot name="aside" />
        {art && <Figlet art={art} label={label} />}
    </div>
    {art && <p aria-hidden="true">&nbsp;</p>}
    <slot />
</div>

<script>
    import { busy, clear, type } from "../lib/console";
    import { reveal } from "../lib/curtain";
    import { screenReady } from "../lib/screen";
    import { isMobile, sleep } from "../lib/terminal";

    const root = document.querySelector<HTMLElement>("[data-session]");

    // Types the command, then lifts the curtain over its output
    async function run(root: HTMLElement) {
        const mobile = isMobile();
        const command = root.dataset.command;

        // Nothing runs before the screen is on
        await screenReady();
        if (command && !mobile) {
            await sleep(600);
            await type(command);
            await sleep(300);
            clear();
        }
        busy(true);
        // Mobile scrolls natively, rows pushing up would land off screen
        // Without scroll, images in the field layer follow the curtain
        const onRow = (bottom: number) =>
            document.dispatchEvent(
                new CustomEvent("curtain:row", { detail: bottom }),
            );
        await reveal(
            root,
            mobile ? 900 : 1500,
            mobile ? { onRow } : { scroll: true, bands: 6 },
        );
        busy(false);
        // Images in the field layer wait for this, see ascii-field.ts
        document.dispatchEvent(new Event("curtain:lifted"));
    }

    // Without .crt (no JS, reduced motion) the content shows as is
    if (root && document.documentElement.classList.contains("crt")) run(root);
</script>

<style>
    @reference "../styles/global.css";

    .banner {
        @apply flex flex-col md:flex-row md:items-center md:gap-x-[2ch];
    }

    /* The aside goes to the right end, the figlet keeps its place */
    .banner > :global(:not(.figlet)) {
        @apply md:order-last md:ml-auto;
    }
</style>
