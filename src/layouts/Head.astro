---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { cleanPath } from '../lib/terminal';

const { title, description, noindex = false, schema } = Astro.props;
const fullTitle = `${title} | filoga.me`;
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site);
const image = new URL("/og.png", Astro.site);
---

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />
    {noindex
        ? <meta name="robots" content="noindex" />
        : <link rel="canonical" href={canonical} />}
    <title>{fullTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="filoga.me" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && (
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(schema)}
        />
    )}

    <Font
        cssVariable="--font-anonymous-pro"
        preload={[{ weight: 400, style: "normal" }]}
    />
    <script is:inline>
        const root = document.documentElement;
        const reduce = matchMedia("(prefers-reduced-motion: reduce)");

        if (!reduce.matches) {
            root.classList.add("crt");
            try {
                if (!sessionStorage.getItem("crt-on")) {
                    root.classList.add("crt-power-on");
                    sessionStorage.setItem("crt-on", "1");
                }
            } catch {}
        }
        // Settings turned off, before paint, see lib/settings.ts
        try {
            const saved = JSON.parse(localStorage.getItem("settings") ?? "{}");
            for (const key in saved) {
                if (saved[key] === false) root.classList.add(`no-${key}`);
            }
        } catch {}
    </script>
    <ClientRouter />
</head>