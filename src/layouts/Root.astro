---
import Head from './Head.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import SvgFilters from './svgFilters.astro';
import Scanlines from '../components/Scanlines.astro';
import Console from '../components/Console.astro';
import "../styles/global.css";

const { title, description, class: className } = Astro.props;
---

<!doctype html>
<html lang="en">
	<Head title={title} description={description} />
	<body class="bg-black">
		<Header />
		<main class:list={["relative isolate", className]}>
			<div class="screen">
				<div class="screen__content">
					<div class="screen__output">
						<slot />
					</div>
					<Console />
				</div>
				<Scanlines />
				<div class="power-on-beam" aria-hidden="true"></div>
			</div>
			<div class="screen-glow" aria-hidden="true"></div>
			<div class="refresh-band" aria-hidden="true"></div>
		</main>
		<SvgFilters />
		<Footer />
		<script>
			import "../lib/screen";
		</script>
	</body>
</html>