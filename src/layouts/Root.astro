---
import Head from './Head.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import SvgFilters from './svgFilters.astro';
import Scanlines from '../components/Scanlines.astro';
import Console from '../components/Console.astro';
import AsciiField from '../components/AsciiField.astro';
import "../styles/global.css";

const {
	title,
	description,
	noindex,
	path,
	schema,
	class: className,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<Head
		title={title}
		description={description}
		noindex={noindex}
		schema={schema}
	/>
	<body class="bg-black">
		<Header />
		<main class:list={["relative isolate", className]}>
			<div class="screen">
				<div class="screen__content">
					<div class="screen__output">
						<slot />
					</div>
					<Console path={path} />
				</div>
				<Scanlines />
				<div class="power-on-beam" aria-hidden="true"></div>
			</div>
			<AsciiField />
			<div class="screen-glow" aria-hidden="true"></div>
			<div class="refresh-band" aria-hidden="true"></div>
		</main>
		<SvgFilters />
		<Footer />
		<script>
			import "../lib/screen";
		</script>
	</body>
</html>