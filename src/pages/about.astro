---
import art from "../assets/hi-filo.txt?raw";
import profile from "../assets/profile.jpeg";
import AsciiImage from "../components/AsciiImage.astro";
import Session from "../components/Session.astro";
import Root from "../layouts/Root.astro";
import { HOBBIES, STACK as stack } from "../lib/profile";
const description =
    "Rodrigo (Filo), web developer in Málaga with 5+ years and 50+ " +
    "projects delivered end to end, from code to servers and deploys.";
---

<Root
    title="About"
    description={description}
>
    <h1 class="sr-only">About</h1>
    <Session command="cd about" art={art} label="Hi, I'm Filo">
        <div slot="aside" class="portrait">
            <AsciiImage src={profile} alt="Portrait of Rodrigo" />
        </div>
        <div class="about">
            <div class="bio">
                <p>
                    My name is Rodrigo, a web developer based in Málaga,
                    working in the industry since I was 18.
                </p>
                <p>
                    In over 5 years I have delivered more than 50 projects end
                    to end: custom WordPress themes and plugins, Payload
                    websites and more.
                </p>
                <p>
                    Strong in both code and systems, I manage the servers and
                    deploys at <a href="https://sebcreativos.es">Seb
                    Creativos</a> and support hundreds of clients.
                </p>
                <section class="hobbies" aria-labelledby="hobbies">
                    <h2 id="hobbies">
                        off the clock{" "}
                        <span aria-hidden="true">{"-".repeat(120)}</span>
                    </h2>
                    <ul>
                        {HOBBIES.map((hobby) => <li>{hobby}</li>)}
                    </ul>
                </section>
            </div>
            <section class="stack" aria-labelledby="stack">
                <h2 id="stack">Stacks and tech I am familiar with</h2>
                <dl>
                    {stack.map(([area, tech]) => (
                        <div>
                            <dt>{area}</dt>
                            <dd>{tech}</dd>
                        </div>
                    ))}
                </dl>
            </section>
        </div>
        <footer class="site">
            <p>
                This site: Astro, TypeScript and Tailwind CSS on Cloudflare
                Pages.
            </p>
        </footer>
    </Session>
</Root>

<style>
    @reference "../styles/global.css";

    /* Beside the banner on desktop, about as tall as the figlet */
    .portrait {
        @apply mb-[1lh] w-3/4 shrink-0 md:mb-0 md:w-[min(30%,7em)];
    }

    .portrait :global(img) {
        @apply aspect-square h-auto w-full object-cover;
    }

    /* Bio on the left, stack list on the right */
    .about {
        @apply grid gap-[1lh] md:gap-x-[4ch];
        @apply md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)];

        clear: both;
    }

    .bio {
        @apply space-y-[1lh] md:text-xl;
    }

    .hobbies {
        @apply md:text-lg;
    }

    /* Dashes run to the width of the column, like the home header */
    .hobbies h2 {
        @apply overflow-hidden font-bold whitespace-nowrap;
    }

    .hobbies h2 span {
        @apply font-normal opacity-50;
    }

    .hobbies li::before {
        content: "- ";
    }

    .stack {
        @apply md:text-xl;
    }

    .stack h2 {
        @apply mb-[0.5lh] italic opacity-75;
    }

    /* Area and its tech side by side, areas share one column width */
    .stack dl {
        @apply grid grid-cols-[auto_1fr] gap-x-[2ch] gap-y-[0.25lh];
    }

    .stack dl > div {
        @apply col-span-2 grid grid-cols-subgrid;
    }

    .stack dt {
        @apply font-bold;
    }

    .site {
        @apply mt-[1lh];
        @apply text-sm opacity-75 md:text-base;
    }
</style>
