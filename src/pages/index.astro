---
import profile from "../assets/profile.jpeg";
import AsciiImage from "../components/AsciiImage.astro";
import Session from "../components/Session.astro";
import Root from "../layouts/Root.astro";

// System info card, neofetch style
const info = [
    { key: "Role", value: "Full stack web developer & SpecOps" },
    { key: "Base", value: "Málaga, Spain" },
    { key: "Uptime", value: "5+ years" },
    { key: "Shipped", value: "50+ projects" },
    { key: "Stack", value: "Astro · TypeScript · Tailwind · Cloudflare" },
];
// Who this site is about, for search engines
const person = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Rodrigo",
    alternateName: "Filo",
    jobTitle: "Full stack web developer",
    url: "https://filoga.me",
    email: "mailto:yo@filoga.me",
    address: {
        "@type": "PostalAddress",
        addressLocality: "Málaga",
        addressCountry: "ES",
    },
    sameAs: ["https://github.com/filo-g"],
};
// Terminal palette rows, normal and bright, like neofetch prints them
const palette = [
    ["#2e3436", "#cc4a4a", "#5fae5f", "#c9a23f", "#4a7bc0", "#a35fb0",
        "#3fa7a7", "#c8ccc6"],
    ["#5a605c", "#ee7070", "#8ad68a", "#ecd06a", "#7ea6e6", "#cc8ad6",
        "#6fd3d3", "#f2f4ef"],
];
const description =
    "Rodrigo (Filo), full stack web developer based in Málaga, Spain. " +
    "5+ years and 50+ projects shipped, from custom WordPress to " +
    "Payload and Astro sites.";
---

<Root
    title="Rodrigo (Filo), full stack web developer in Málaga"
    description={description}
    schema={person}
>
    <Session command="exec filoga.me" art={false}>
        <div class="fetch">
            <div class="portrait">
                <AsciiImage
                    src={profile}
                    alt="Portrait of Rodrigo"
                    loading="eager"
                    fetchpriority="high"
                />
            </div>
            <div class="card">
                <h1 class="who">
                    <span aria-hidden="true"><b>rodrigo</b>@filoga.me</span>
                    <span class="sr-only">
                        Rodrigo, full stack web developer
                    </span>
                </h1>
                <p class="rule" aria-hidden="true">{"-".repeat(17)}</p>
                <dl>
                    {info.map((item) => (
                        <div>
                            <dt>{item.key}</dt>
                            <dd>{item.value}</dd>
                        </div>
                    ))}
                </dl>
                <div class="palette" aria-hidden="true">
                    {palette.map((row) => (
                        <p>
                            {row.map((color) => (
                                <span style={`background: ${color}`}></span>
                            ))}
                        </p>
                    ))}
                </div>
            </div>
        </div>
    </Session>
</Root>

<style>
    @reference "../styles/global.css";

    .fetch {
        @apply grid items-center gap-[1lh] md:grid-cols-[auto_1fr];
        @apply md:gap-x-[4ch] md:text-2xl;
    }

    .portrait {
        @apply w-3/4 md:w-[19em];
    }

    .portrait :global(img) {
        @apply aspect-square h-auto w-full object-cover;
    }

    .who {
        @apply text-xl md:text-3xl;
    }

    .who b {
        @apply font-bold;
    }

    .rule {
        @apply opacity-50;
    }

    dl {
        @apply grid grid-cols-[auto_1fr] gap-x-[2ch];
    }

    dl > div {
        @apply col-span-2 grid grid-cols-subgrid;
    }

    dt {
        @apply font-bold;
    }

    .palette {
        @apply mt-[0.75lh];
    }

    .palette p {
        @apply flex;
    }

    .palette span {
        @apply h-[1lh] w-[2.5ch];
    }
</style>
